#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 The Gatepost authors
# SPDX-License-Identifier: Apache-2.0
# Builds dist/gatepost-postcode-for-woocommerce.zip, the file that WordPress.org and the GitHub
# release get. It holds the tracked plugin files and the bundled SDK in vendor-prefixed/. Strauss
# writes that folder again from vendor/ in the checkout, on each run. A file that git does not
# track, such as a backup in src/, never reaches the zip. It holds no dev package, test or config
# file.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
slug='gatepost-postcode-for-woocommerce'
stage="$root/build/zip/$slug"

cd "$root"
rm -rf "$root/build/zip" "$root/dist" vendor-prefixed
vendor/bin/strauss > /dev/null
mkdir -p "$stage" "$root/dist"
git ls-files -z "$slug.php" uninstall.php readme.txt LICENSE LICENSES NOTICE src \
  | tar --null -T - -cf - | tar -xf - -C "$stage"
cp -R vendor-prefixed "$stage/"
(cd "$root/build/zip" && zip -qrX "$root/dist/$slug.zip" "$slug")
echo "Built dist/$slug.zip."
